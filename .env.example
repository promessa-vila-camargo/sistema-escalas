SESSION_SECRET="gere-com: openssl rand -base64 32"

# Banco Postgres gratuito (ex: Neon — neon.tech). Crie um projeto lá, copie a
# connection string e cole aqui.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Primeiro login de administrador, criado por `npm run seed`. Troque a senha
# em /conta assim que logar; os demais voluntários são cadastrados depois
# pelo próprio admin em /admin/pessoas.
ADMIN_SEED_USERNAME="admin"
ADMIN_SEED_PASSWORD="defina-uma-senha-forte-aqui"
