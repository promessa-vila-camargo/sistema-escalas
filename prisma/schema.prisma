generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VOLUNTARIO
}

model User {
  id           String   @id @default(cuid())
  nome         String
  username     String?  @unique
  passwordHash String?
  role         Role     @default(VOLUNTARIO)
  ativo        Boolean  @default(true)
  /// Voluntário com verTudo=true enxerga a escala inteira (como o admin),
  /// mas só edita as próprias funções — default é ver só o que é dele.
  verTudo      Boolean  @default(false)
  createdAt    DateTime @default(now())

  funcoes     UserFuncao[]
  atribuicoes Atribuicao[]
}

model Categoria {
  id    String @id @default(cuid())
  nome  String
  ordem Int    @default(0)

  funcoes Funcao[]
}

/**
 * diasSemana: em quais dias de culto essa função é necessária — 0=domingo,
 * 3=quarta, 6=sábado (mesma convenção do Date#getDay() do JS). Default é
 * todos os três; uma função só de fim de semana (ex.: Datashow) tem [0,6].
 */
model Funcao {
  id          String @id @default(cuid())
  nome        String
  ordem       Int    @default(0)
  categoriaId String
  diasSemana  Int[]  @default([0, 3, 6])

  categoria   Categoria    @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  usuarios    UserFuncao[]
  atribuicoes Atribuicao[]
}

/** Uma linha por (pessoa, função que ela está habilitada a exercer). */
model UserFuncao {
  id       String @id @default(cuid())
  userId   String
  funcaoId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  funcao Funcao @relation(fields: [funcaoId], references: [id], onDelete: Cascade)

  @@unique([userId, funcaoId])
}

/**
 * Uma linha por (data do culto, função) — existe sempre que alguém preenche
 * aquela função naquele culto. O escalado é texto livre (nomeEscalado):
 * não exige cadastro prévio da pessoa. userId fica preservado (não é mais
 * lido pela UI) apenas para não descartar histórico de quem logou e se
 * autoescalou antes dessa mudança; novas escritas não o usam mais.
 */
/** turno: "DIA" (culto normal) ou "NOITE" (evento extra à noite, mesmo dia). */
model Atribuicao {
  id            String   @id @default(cuid())
  data          DateTime @db.Date
  funcaoId      String
  userId        String?
  nomeEscalado  String?
  turno         String   @default("DIA")

  funcao Funcao @relation(fields: [funcaoId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([data, funcaoId, turno])
}

/**
 * Observação livre por culto (ex.: "também teremos culto à noite às 19h"),
 * a flag "tem evento à noite" e o ministério/departamento responsável por
 * organizar aquele culto (só faz sentido sábado/domingo) — só o admin
 * escreve, todo mundo que vê aquele dia lê.
 */
model CultoNota {
  id                    String   @id @default(cuid())
  data                  DateTime @unique @db.Date
  texto                 String?
  temEventoNoite        Boolean  @default(false)
  ministerioResponsavel String?
}
